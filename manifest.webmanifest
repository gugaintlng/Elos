{
  "name": "Elos — Estimulação Cognitiva",
  "short_name": "Elos",
  "description": "Plataforma de estimulação cognitiva adaptativa para pessoas idosas em lares e unidades de cuidados continuados. Funciona sem ligação à internet.",
  "lang": "pt-PT",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "id": "elos-estimulacao-cognitiva",
  "display": "standalone",
